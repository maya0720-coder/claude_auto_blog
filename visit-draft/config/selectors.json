{
  "_comment": "네이버 화면 선택자. 0단계 PoC에서 실제 화면으로 검증해 확정한다. 각 대상은 위에서부터 순서대로 시도한다(role/label → text → CSS).",
  "login": {
    "loginUrl": "https://nid.naver.com/nidlogin.login",
    "checkUrl": "https://blog.naver.com/",
    "sessionCookie": "NID_AUT",
    "loginHostFragment": "nid.naver.com"
  },
  "blog": {
    "rssUrl": "https://rss.blog.naver.com/{blogId}.xml",
    "postUrl": "https://m.blog.naver.com/{blogId}/{logNo}",
    "allowedHosts": [
      "blog.naver.com",
      "m.blog.naver.com"
    ],
    "container": ".se-main-container",
    "component": ".se-component",
    "paragraph": ".se-text-paragraph",
    "blockClasses": {
      "heading": "se-sectionTitle",
      "quote": "se-quotation",
      "text": "se-text",
      "imageStrip": "se-imageStrip",
      "image": "se-image",
      "divider": "se-horizontalLine",
      "map": "se-placesMap",
      "sticker": "se-sticker",
      "link": "se-oglink"
    },
    "legacyContainers": [
      "#postViewArea",
      ".se_component_wrap",
      "#viewTypeSelector",
      ".post_ct",
      "#post-view"
    ]
  },
  "editor": {
    "writeUrl": "https://blog.naver.com/{blogId}?Redirect=Write&categoryNo={categoryNo}",
    "frame": "#mainFrame",
    "targets": {
      "resumeDialog": [
        {
          "css": ".se-popup-alert-confirm"
        }
      ],
      "resumeDialogNew": [
        {
          "css": ".se-popup-alert-confirm .se-popup-button-cancel"
        },
        {
          "role": "button",
          "name": "취소"
        }
      ],
      "helpPanelClose": [
        {
          "css": ".se-help-panel-close-button"
        }
      ],
      "title": [
        {
          "css": ".se-documentTitle .se-text-paragraph"
        },
        {
          "text": "제목"
        }
      ],
      "body": [
        {
          "css": ".se-component.se-text .se-text-paragraph"
        },
        {
          "text": "본문에 #을 이용하여 태그를 사용해보세요!"
        }
      ],
      "imageButton": [
        {
          "role": "button",
          "name": "사진"
        },
        {
          "css": "button.se-image-toolbar-button"
        }
      ],
      "uploadedImage": [
        {
          "css": ".se-component.se-image img"
        }
      ],
      "categorySelect": [
        {
          "role": "combobox",
          "name": "카테고리"
        },
        {
          "css": "[class*='selectbox_button']"
        }
      ],
      "saveButton": [
        {
          "role": "button",
          "name": "저장"
        },
        {
          "css": "button[class*='save_btn']"
        }
      ],
      "saveDone": [
        {
          "text": "저장되었습니다"
        },
        {
          "css": "[class*='toast']"
        }
      ],
      "imageComponent": [
        {
          "css": ".se-component.se-image"
        }
      ]
    },
    "forbidden": {
      "_comment": "발행 관련 요소. publishGuard가 클릭 직전에 검사해 차단한다. 삭제·완화 금지.",
      "texts": [
        "발행",
        "예약",
        "공개 설정"
      ],
      "classFragments": [
        "publish_btn",
        "confirm_btn",
        "publish"
      ]
    },
    "afterImageParagraph": "xpath=following-sibling::div[contains(concat(\" \",normalize-space(@class),\" \"),\" se-text \")][1]//p[contains(@class,\"se-text-paragraph\")]",
    "imageCaptionInImage": ".se-caption .se-text-paragraph"
  }
}
